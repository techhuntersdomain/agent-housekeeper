# agent-housekeeper settings. Copied to ~/.agent-housekeeper/config.env on install; edit that copy.
# Changes apply on the next check (every 10 minutes). No restart needed.

# --- Alerts (a macOS notification; repeats at most every ALERT_REPEAT_HOURS) ---
APP_ALERT_GB=8            # one app, with its helpers, uses more than this
SWAP_ALERT_GB=4           # this much memory has been pushed onto the disk (the Mac gets slow)
FREE_ALERT_PCT=15         # free memory falls below this percent
NOTIFY=1
ALERT_REPEAT_HOURS=6

# --- Closing finished automation runs (OFF until you turn it on) ---
# An "automation run" is an agent started with a written task, for example by a scheduler.
# It is closed only when ALL of these are true: it has done no real work for IDLE_MINUTES,
# it is older than MIN_AGE_MINUTES, it is not inside an app listed in MANAGED_BY_APP,
# and it does not match PROTECT_PATTERN. Sessions started without a written task are never closed.
CLOSE_IDLE_AUTOMATION=0
IDLE_MINUTES=120
MIN_AGE_MINUTES=60
PROTECT_PATTERN=''
MANAGED_BY_APP="Claude"

# --- Helpers left behind (MCP servers, headless browsers whose agent already exited) ---
CLOSE_ORPHANS=0

# --- Which programs count as agents ---
AGENT_NAMES="claude codex gemini opencode cursor-agent aider qwen goose amp crush"
